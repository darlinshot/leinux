configuration {
    modes: "window,run,ssh,drun";
    sorting-method: "normal";
    show-icons: true;
    matching: "regex";
    drun-match-fields: "name";
    display-run: "Run:";
    display-ssh: "SSH:";
    display-drun: "Apps:";
    display-window: "Windows:";
}

@theme "~/.config/rofi/colors.rofi"

/* Signal Deck — a quiet control surface.
   One green signal marks the active row; everything else stays out of the way. */
* {
    font: "JetBrainsMono Nerd Font Mono 13";

    background-color:   transparent;
    text-color:         @tx2;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       center;
    width:          600px;
    height:         640px;   /* footer is 160px = 1/4 of this */
    y-offset:       -32px;
    border-radius:  20px;

    border: 1px;
    border-color:       @bd1;
    background-color:   @bg1;
}

mainbox {
    padding:    18px;
    expand:     true;
    children:   [ inputbar, message, listview, footer ];
}

inputbar {
    children: [ prompt, entry ];

    background-color:   @bg2;
    border-color:       @line;
    border-radius:      12px;
    border:             1px;

    padding:    11px 14px;
    spacing:    12px;
}

prompt {
    font:        "JetBrainsMono Nerd Font Mono Medium 14";
    text-color:  @sky;
    width:       6em;   /* keeps the entry edge steady across modes */
}

entry {
    text-color:         @tx2;
    placeholder:        "Search";
    placeholder-color:  @bd2;
    cursor-color:       @bat-green;
    cursor-width:       2px;
}

message {
    margin:             12px 0 0;
    border-radius:      10px;
    background-color:   @fg1;
}

textbox {
    padding:    10px 14px;
    font:       "JetBrainsMono Nerd Font Mono 12";
    text-color: @tx1;
}

listview {
    background-color:   transparent;
    margin:             14px 0 0;
    expand:             true;   /* fills the top 3/4 with the apps list */
    columns:            1;
    lines:              8;
    spacing:            4px;
    fixed-height:       false;
    scrollbar:          true;
}

element {
    orientation:        horizontal;
    children:           [ element-icon, element-text ];
    padding:            9px 12px;
    spacing:            12px;
    border:             0px 0px 0px 3px;
    border-color:       transparent;
    border-radius:      8px;
    background-color:   transparent;
    text-color:         @tx1;
}

element-icon {
    size:           1.25em;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    highlight:      bold #9fbe8f;   /* literal color: @refs are invalid here */
}

element normal urgent {
    text-color: @er1;
}

element normal active {
    text-color: @bat-orange;
}

element selected normal, element selected active {
    background-color:   @fg2;
    border-color:       @bat-green;
    text-color:         @tx2;
}

scrollbar {
    background-color:       transparent;
    border-color:           transparent;
    handle-color:           @bd1;
    handle-width:           4px;
    handle-rounded-corners: true;
}

footer {
    orientation:    horizontal;
    children:       [ textbox-hints, footer-spacer, textbox-count-label, num-filtered-rows, textbox-slash, num-rows ];

    padding:            71px 16px;   /* 71 + ~18 content + 71 = 160px = 1/4 of window */
    expand:             false;
    margin:             12px 0 0;
    border:             1px 0 0;
    border-color:       @line;
    background-color:   transparent;   /* same surface as the window; divider only */
}

footer-spacer {
    expand: true;
}

textbox-hints {
    content:        "up/down move    enter open    esc close";
    font:           "JetBrainsMono Nerd Font Mono 10";
    text-color:     @bd2;
    vertical-align: 0.5;
}

textbox-count-label {
    content:        "results";
    font:           "JetBrainsMono Nerd Font Mono 10";
    text-color:     @bd2;
    vertical-align: 0.5;
}

textbox-slash {
    content:    "/";
}

num-filtered-rows, textbox-slash, num-rows {
    font:           "JetBrainsMono Nerd Font Mono 10";
    text-color:     @bd2;
    padding:        0 3px;
    vertical-align: 0.5;
}
